<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email Verification</title>
  <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">
  <link rel="stylesheet" href="/user/forgotPassword.css">
</head>

<body>
  <div class="container">
    <div class="logo">OLD RICH</div>
    <h1>Email Verification</h1>

    <% if(message){ %>
      <h5 style="color: red;">
        <%= message %>
      </h5>
      <% } %>

        <form id="emailForm" method="post" action="/forgot-email-valid">
          <div class="input-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="Enter your email address" />
            <div class="error" id="emailError">Please enter a valid email address.</div>
          </div>

          <button type="submit" class="verify-btn" id="verifyBtn">
            <span class="btn-text">Send Verification Email</span>
            <span class="loader" style="display:none;"></span>
          </button>
        </form>

        <p class="signup-link">Don't have an account? <a href="/register">Sign up</a></p>
  </div>

  <script src="/js/user/forgotPassword.js"></script>
</body>

</html>