<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Wallet </title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">
    <link rel="stylesheet" href="/user/wallet.css">
</head>

<body>
    <%- include('../../views/partials/user/header',{title:'Wishlist'}) %>
        <div class="container">
            <header>
                <div class="logo">Green<span>Wallet</span></div>
                <div class="user-info">
                    <img class="user-avatar"
                        src="<%= user.userProfileImage || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.username) + '&background=2e7d32&color=fff&size=160' %>">
                    <div>
                        <%= user.username %>
                    </div>
                </div>
            </header>

            <div class="wallet-header">
                <h1>YOUR WALLET</h1>
                <p>Manage your wallet and transactions</p>
            </div>

            <div class="wallet-grid">
                <div class="card balance-card">
                    <h2>Wallet Balance</h2>
                    <div class="balance-amount">₹ <%= wallet.balance.toFixed(2) %>
                    </div>

                    <div class="stats-container">
                        <div class="stat-item">
                            <div class="stat-value">₹ <%= wallet.totalCredited.toFixed(2) %>
                            </div>
                            <div class="stat-label">TOTAL CREDITED</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">₹ <%= wallet.totalDebited.toFixed(2) %>
                            </div>
                            <div class="stat-label">TOTAL DEBITED</div>
                        </div>
                    </div>
                </div>

                <div class="card referral-card">
                    <h2>Your Referral Code</h2>
                    <p>Share your code with friends and earn rewards</p>

                    <div class="referral-code">
                        <%= user.referralCode %>
                    </div>

                    <div class="referral-cta">
                        EARN ₹100 FOR EACH SUCCESSFUL REFERRAL
                    </div>
                </div>
            </div>

            <div class="transaction-history">
                <% if(wallet.transaction?.length < 1){ %>
                    <h2>Transaction History</h2>
                    <div class="empty-state">
                        <i class="fas fa-receipt"></i>
                        <p>No transactions yet</p>
                    </div>
                    <% } else { %>
                        <h2>Transaction History</h2>
                        <ul class="transaction-list">
                            <% wallet.transactions?.forEach((transaction)=> { %>
                                <% if(transaction.type==='credit' ){ %>
                                    <li class="transaction-item">
                                        <div class="transaction-info">
                                            <div class="transaction-icon">
                                                <i class="bi bi-credit-card"></i>
                                            </div>
                                            <div class="transaction-details">
                                                <h3>Deposit</h3>
                                                <p>
                                                    <%= new Date(transaction.createdAt).toLocaleString('en-IN', {
                                                        weekday: 'short' , year: 'numeric' , month: 'short' ,
                                                        day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %> • <%=
                                                            transaction.reason %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="transaction-amount credit">+₹ <%= transaction.amount.toFixed(2) %>
                                        </div>
                                    </li>
                                    <% } else if(transaction.type==='debit' ) { %>
                                        <li class="transaction-item">
                                            <div class="transaction-info">
                                                <div class="transaction-icon">
                                                    <i class="bi bi-credit-card-2-front"></i>
                                                </div>
                                                <div class="transaction-details">
                                                    <h3>Purchase</h3>
                                                    <p>
                                                        <%= new Date(transaction.createdAt).toLocaleString('en-IN', {
                                                            weekday: 'short' , year: 'numeric' , month: 'short' ,
                                                            day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %> •
                                                            <%= transaction.reason %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="transaction-amount debit">-₹ <%= transaction.amount.toFixed(2)
                                                    %>
                                            </div>
                                        </li>
                                        <% } %>
                                            <% }) %>
                        </ul>
                        <% } %>
            </div>
        </div>

        <script src="/js/user/wallet.js"></script>
</body>

</html>