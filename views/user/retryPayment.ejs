<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Retry Payment</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">
    <link rel="stylesheet" href="/user/retrypayment.css">
</head>

<body>
    <div class="container">
        <div class="header">
            <div class="header-icon">
                <i class="fas fa-credit-card"></i>
            </div>
            <h1>Retry Payment</h1>
            <p>Complete your transaction securely</p>
        </div>

        <div class="content">
            <div class="message">
                <h2><i class="fas fa-exclamation-circle"></i> Payment Failed</h2>
                <p>We encountered an issue processing your payment. Please try again.</p>
            </div>

            <div class="payment-details">
                <h3><i class="fas fa-receipt"></i> Transaction Details</h3>
                <div class="detail-row">
                    <span>Order ID:</span>
                    <span>
                        <%= order.orderId %>
                    </span>
                </div>
                <div class="detail-row">
                    <span>Date:</span>
                    <span>
                        <%= new Date(order.createdOn).toLocaleString() %>
                    </span>
                </div>
                <div class="detail-row">
                    <span>Payment Method:</span>
                    <span>Razorpay (Online)</span>
                </div>
                <div class="detail-row">
                    <span>Amount:</span>
                    <span>₹<%= order.finalAmount %></span>
                </div>
            </div>

            <button id="retryPayBtn" class="retry-button">
                <i class="fas fa-redo-alt"></i> Retry Payment Securely
            </button>

            <a href="/" class="home-btn">Go to Home</a>

            <div class="secure-notice">
                <i class="fas fa-lock"></i>
                <span>Your payment information is secure and encrypted</span>
            </div>

            <div class="support">
                <p>Need help? <a href="#">Contact our support team</a></p>
            </div>
        </div>
    </div>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const retryBtn = document.getElementById('retryPayBtn');
        const APP_ORDER_ID = '<%= order.orderId %>';

        retryBtn.addEventListener('click', async function () {
            retryBtn.disabled = true;
            retryBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

            try {
                // Reuse existing DB order — creates a new Razorpay session only
                const res = await fetch('/reCreateRazorpayOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId: APP_ORDER_ID })
                });
                const data = await res.json();

                if (!data.success) {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'Could not initiate retry.' });
                    retryBtn.disabled = false;
                    retryBtn.innerHTML = '<i class="fas fa-redo-alt"></i> Retry Payment Securely';
                    return;
                }

                const options = {
                    key: data.key,
                    amount: data.amount,
                    currency: data.currency,
                    name: 'OLD RICH',
                    description: `Retry Payment for Order #${APP_ORDER_ID}`,
                    order_id: data.orderId,
                    handler: async function (response) {
                        try {
                            const verifyRes = await fetch('/verify-razorpay-payment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_signature: response.razorpay_signature
                                })
                            });
                            const verifyData = await verifyRes.json();
                            if (verifyData.success) {
                                window.location.href = `/orderSuccess?orderId=${encodeURIComponent(verifyData.orderId)}`;
                            } else {
                                window.location.href = `/paymentFaildRetry?orderId=${encodeURIComponent(APP_ORDER_ID)}`;
                            }
                        } catch (err) {
                            window.location.href = `/paymentFaildRetry?orderId=${encodeURIComponent(APP_ORDER_ID)}`;
                        }
                    },
                    modal: {
                        ondismiss: function () {
                            window.location.href = `/paymentFaildRetry?orderId=${encodeURIComponent(APP_ORDER_ID)}`;
                        }
                    },
                    theme: { color: '#3399cc' }
                };

                const rzp = new Razorpay(options);
                rzp.on('payment.failed', function () {
                    window.location.href = `/paymentFaildRetry?orderId=${encodeURIComponent(APP_ORDER_ID)}`;
                });
                rzp.open();

            } catch (err) {
                window.location.href = `/paymentFaildRetry?orderId=${encodeURIComponent(APP_ORDER_ID)}`;
            }
        });
    </script>
</body>

</html>