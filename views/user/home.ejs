<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OLDRICH - Premium Fashion</title>
  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">

  <link rel="stylesheet" href="/user/home.css">
</head>

<body>
  <%- include('../../views/partials/user/header',{title:'Home-page'}) %>

    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <h1>Old Rich</h1>
        <p>Discover the timeless elegance of premium old money clothing for the discerning gentleman</p>
      </div>
    </section>

    <!-- Brand Values -->
    <section class="section values-section">
      <div class="container">
        <div class="section-title">
          <h2>OUR VALUES</h2>
          <p class="section-subtitle">What sets Old Rich apart</p>
        </div>
        <div class="row g-4">
          <div class="col-md-4">
            <div class="value-card">
              <div class="value-icon">
                <i class="bi bi-award"></i>
              </div>
              <h3 class="value-title">Premium Quality</h3>
              <p>Only the finest materials and craftsmanship for lasting elegance</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="value-card">
              <div class="value-icon">
                <i class="bi bi-clock-history"></i>
              </div>
              <h3 class="value-title">Timeless Style</h3>
              <p>Classic designs that transcend trends and seasons</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="value-card">
              <div class="value-icon">
                <i class="bi bi-person-check"></i>
              </div>
              <h3 class="value-title">Sophisticated Fit</h3>
              <p>Tailored cuts designed for the discerning gentleman</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURED PRODUCTS -->
    <section class="section featured-products">
      <div class="container">
        <div class="section-title">
          <h2>FEATURED PRODUCTS</h2>
          <p class="section-subtitle">Our most popular items this season</p>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
          <% for(let i=0 ; i < products.length ; i++){ %>
            <div class="col">
              <div class="product-card">
                <% if(i < 2) { %>
                  <span class="product-badge">NEW</span>
                  <% } %>
                    <div class="product-image-container">
                      <img src="<%= products[i].productImage[0] %>" alt="<%= products[i].productName %>"
                        class="product-image">
                      <a href="/productDetails?productId=<%= products[i]._id %>" style="text-decoration: none;">
                        <div class="product-overlay">
                          <button class="btn btn-sm btn-outline-light quick-view-btn">QUICK VIEW</button>
                        </div>
                      </a>
                    </div>
                    <div class="product-info">
                      <h3 class="product-title">
                        <%= products[i].productName %>
                      </h3>
                      <div class="product-price">Rs <%= products[i].variants[0]?.salePrice %>
                      </div>
                      <a href="/productDetails?productId=<%= products[i]._id %>" style="text-decoration: none;">
                        <button class="btn btn-success add-to-cart-btn">VIEW</button>
                      </a>
                    </div>
              </div>
            </div>
            <% } %>
        </div>
        <div class="text-center mt-5">
          <a href="/shop" class="btn btn-outline-dark view-all-btn">VIEW ALL PRODUCTS</a>
        </div>
      </div>
    </section>

    <!-- OLD MONEY CATEGORIES -->
    <section class="section categories-section bg-light">
      <div class="container">
        <div class="section-title">
          <h2>OLD MONEY ESSENTIALS</h2>
          <p class="section-subtitle">Timeless clothing for refined gentlemen</p>
        </div>

        <div class="row g-4">

          <!-- Polo Shirts -->
          <div class="col-md-4">
            <div class="category-card">
              <img src="https://voraodi.shop/images/homePage-polo-img.png" alt="Polo Shirts" class="category-image">
              <div class="category-overlay">
                <h3 class="category-title">Polo Shirts</h3>
                <p class="category-description">
                  Effortless luxury polos inspired by classic European leisurewear
                </p>
                <a href="/shop?category=686e9f627813452882732142" class="category-btn">EXPLORE</a>
              </div>
            </div>
          </div>

          <!-- Linen Pants -->
          <div class="col-md-4">
            <div class="category-card">
              <img src="	https://voraodi.shop/images/homePage-linen-img.png" alt="Linen Pants" class="category-image">
              <div class="category-overlay">

                <h3 class="category-title">Linen Shirts</h3>
                <p class="category-description">
                  Lightweight linen trousers for relaxed, timeless sophistication
                </p>
                <a href="/shop?category=685904cff2f119b1ea7724d2" class="category-btn">EXPLORE</a>
              </div>
            </div>
          </div>


          <div class="col-md-4">
            <div class="category-card">
              <img src="https://voraodi.shop/images/homePage-linen-pant.png" alt="Striped Shirts"
                class="category-image">
              <div class="category-overlay">

                <h3 class="category-title">Linen pants</h3>
                <p class="category-description">
                  Iconic striped shirts rooted in traditional old-money style
                </p>
                <a href="/shop?category=686e9b0d7813452882731fbc" class="category-btn">EXPLORE</a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- Newsletter Section -->
    <section class="newsletter-section">
      <div class="container">
        <div class="newsletter-content">
          <div class="newsletter-text">
            <h3>Join the Old Rich Community</h3>
            <p>Subscribe to our newsletter for exclusive offers, style tips, and early access to new collections</p>
          </div>
          <form class="newsletter-form d-flex gap-2 flex-column flex-md-row">
            <input type="email" class="form-control" placeholder="Enter your email address" required>
            <button type="submit" class="btn btn-secondary">SUBSCRIBE</button>
          </form>
        </div>
      </div>
    </section>

    <%- include('../../views/partials/user/footer',{title:'Home-page'}) %>

      <script src="/js/user/home.js"></script>
</body>

</html>