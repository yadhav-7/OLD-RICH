<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update Email Address</title>
  <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">
  <link rel="stylesheet" href="/user/newMail.css">
</head>

<body>
  <form id="emailForm" action="/update-email" method="POST" class="container">
    <div class="logo">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="#2e7d32">
        <path
          d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" />
      </svg>
    </div>

    <h2>Update Your Email</h2>
    <p class="description">Enter your new email address</p>

    <% if (typeof message !=='undefined' && message) { %>
      <div class="server-message <%= message.toLowerCase().includes('success') ? 'success' : 'error' %>">
        <%= message %>
      </div>
      <% } %>

        <div class="input-group">
          <label for="email">New Email Address</label>
          <input name="newEmail" id="email" placeholder="example@domain.com"
            value="<%= typeof oldEmail !== 'undefined' ? oldEmail : '' %>">
          <div id="errorMsg" class="error">Please enter a valid email address.</div>
        </div>

        <button type="submit" id="submitBtn">Send Verification OTP</button>
  </form>

  <script src="/js/user/newMail.js"></script>
</body>

</html>