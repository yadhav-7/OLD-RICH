<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - Green & White Theme</title>
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/user/orderDetailPages.css">
</head>

<body>
    <%- include('../../views/partials/user/header',{title:'order details'}) %>

        <!-- Order Details Content -->
        <div class="container">
            <!-- Order Header -->
            <div class="order-header">
                <div class="order-header-left">
                    <h1><i class="fas fa-receipt"></i> Order Details</h1>
                    <div class="order-info">
                        <span class="order-id">Order #<%= order.orderId %></span>
                        <span class="order-date">
                            <i class="fas fa-calendar-alt"></i>
                            <%= new Date(order.createdOn).toLocaleDateString('en-US', { year: 'numeric' , month: 'long'
                                , day: 'numeric' }) %>
                        </span>
                    </div>
                </div>
                <div class="order-header-right">
                    <span class="order-status status-<%= order.status.toLowerCase().replace(' ', '-') %>">
                        <%= order.status %>
                    </span>
                    <!-- Invoice Download Button - Always visible -->
                    <a class="btn btn-invoice btn-sm" href="/generateInvoice?orderId=<%= order.orderId %>">
                        <i class="fas fa-download"></i>
                        <span class="btn-text">Download Invoice</span>
                    </a>
                </div>
            </div>

            <!-- Order Tracker -->
            <div class="order-tracker">
                <h2 class="tracker-title">
                    <i class="fas fa-shipping-fast"></i> Order Tracking
                </h2>

                <div class="timeline">
                    <div class="timeline-progress" id="timelineProgress"></div>

                    <div class="timeline-step">
                        <div
                            class="step-icon <%= ['Processing', 'Shipped', 'Delivered', 'returnRequested', 'returned', 'reutrnRejected'].includes(order.status) ? 'completed' : (order.status === 'Pending' ? 'active' : '') %>">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div
                            class="step-label <%= ['Processing', 'Shipped', 'Delivered', 'returnRequested', 'returned', 'reutrnRejected'].includes(order.status) ? 'completed' : (order.status === 'Pending' ? 'active' : '') %>">
                            Order Placed</div>
                        <div class="step-date">
                            <%= new Date(order.createdOn).toLocaleDateString('en-US', { month: 'short' , day: 'numeric'
                                }) %>
                        </div>
                    </div>

                    <div class="timeline-step">
                        <div
                            class="step-icon <%= ['Shipped', 'Delivered', 'returnRequested', 'returned', 'reutrnRejected'].includes(order.status) ? 'completed' : (order.status === 'Processing' ? 'active' : '') %>">
                            <i class="fas fa-box-open"></i>
                        </div>
                        <div
                            class="step-label <%= ['Shipped', 'Delivered', 'returnRequested', 'returned', 'reutrnRejected'].includes(order.status) ? 'completed' : (order.status === 'Processing' ? 'active' : '') %>">
                            Processing</div>
                    </div>

                    <div class="timeline-step">
                        <div
                            class="step-icon <%= ['Delivered', 'returnRequested', 'returned', 'reutrnRejected'].includes(order.status) ? 'completed' : (order.status === 'Shipped' ? 'active' : '') %>">
                            <i class="fas fa-truck"></i>
                        </div>
                        <div
                            class="step-label <%= ['Delivered', 'returnRequested', 'returned', 'reutrnRejected'].includes(order.status) ? 'completed' : (order.status === 'Shipped' ? 'active' : '') %>">
                            Shipped</div>
                    </div>

                    <div class="timeline-step">
                        <div
                            class="step-icon <%= ['Delivered', 'returnRequested', 'returned', 'reutrnRejected'].includes(order.status) ? 'completed' : '' %> <%= order.status === 'Cancelled' ? 'cancelled' : '' %>">
                            <i class="fas <%= order.status === 'returned' ? 'fa-undo' : 'fa-check-double' %>"></i>
                        </div>
                        <div
                            class="step-label <%= ['Delivered', 'returnRequested', 'returned', 'reutrnRejected'].includes(order.status) ? 'completed' : '' %> <%= order.status === 'returned' ? 'returned' : '' %> <%= order.status === 'Cancelled' ? 'cancelled' : '' %>">
                            <%= order.status==='returned' ? 'Returned' : (order.status==='Cancelled' ? 'Cancelled'
                                : 'Delivered' ) %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="order-container">
                <!-- Order Items -->
                <div class="order-items-section">
                    <h3 class="section-title">
                        <i class="fas fa-shopping-bag"></i> Order Items
                        <span class="item-count">(<%= order.orderedItems.length %> items)</span>
                    </h3>

                    <div class="order-items">
                        <% order.orderedItems.forEach((item, index)=> { %>
                            <div class="order-item">
                                <!-- Item Status Indicator (Floating) -->
                                <div class="item-status-indicator">
                                    <span id="itemStaus<%=index%>"
                                        class="status-indicator status-<%= item.status.toLowerCase().replace(' ', '-') %>">
                                        <%= item.status %>
                                    </span>
                                    <% if (item.isReturned==='returnRequested' ) { %>
                                        <span class="return-status return-requested"><i class="fas fa-clock"></i> Return
                                            Pending</span>
                                        <% } else if (item.isReturned==='returned' ) { %>
                                            <span class="return-status return-returned"><i
                                                    class="fas fa-check-circle"></i> Returned</span>
                                            <% } else if (item.isReturned==='reutrnRejected' ) { %>
                                                <span class="return-status return-rejected"><i
                                                        class="fas fa-times-circle"></i> Return Rejected</span>
                                                <% } %>
                                </div>

                                <div class="item-image">
                                    <% if(item.product.productImage && item.product.productImage[0]) { %>
                                        <img src="<%= item.product.productImage[0] %>"
                                            alt="<%= item.product.productName %>">
                                        <% } else { %>
                                            <div class="product-image-placeholder">
                                                <i class="fas fa-image"></i>
                                            </div>
                                            <% } %>
                                </div>

                                <div class="item-details">
                                    <h4 class="item-name">
                                        <%= item.product.productName %>
                                    </h4>
                                    <div class="item-variant">
                                        <span class="variant-tag">Size: <%= item.size %></span>
                                    </div>
                                    <div class="item-meta">
                                        <span class="item-price">₹<%= item.price.toLocaleString('en-IN') %></span>
                                        <span class="item-quantity">Qty: <%= item.quantity %></span>
                                        <span class="item-total">Total: ₹<%= (item.price *
                                                item.quantity).toLocaleString('en-IN') %></span>
                                    </div>

                                    <div class="item-actions">
                                        <% if (order.status !== 'Failed' && (item.status==='Pending' || item.status==='Processing' ||
                                            item.status==='Shipped')) { %>
                                            <button type="button" class="btn btn-danger btn-sm"
                                                id="cancelItem<%= index %>"
                                                onclick="cancelItem('<%= order._id %>', '<%= item._id %>','<%= index %>')">
                                                <i class="fas fa-times"></i> Cancel Item
                                            </button>
                                            <% } else if (item.status==='cancelled' ) { %>
                                                <button type="button" class="btn btn-danger btn-sm btn-disabled"
                                                    disabled>
                                                    <i class="fas fa-ban"></i> Cancelled
                                                </button>
                                                <% } %>

                                                    <% if (order.status !== 'Failed' && item.status==='Delivered') { %>
                                                        <!-- return button for delivered item -->
                                                        <button type="button" class="btn btn-warning btn-sm"
                                                            onclick="returnItem('<%= item._id %>','<%= order._id %>')">
                                                            <i class="fas fa-undo"></i> Return Item
                                                        </button>
                                                        <% } %>

                                                            <a href="/productDetails?productId=<%= item.product._id %>"
                                                                class="btn btn-outline btn-sm">
                                                                <i class="fas fa-eye"></i> View Product
                                                            </a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>

                <!-- Order Sidebar -->
                <div class="order-sidebar">
                    <!-- Order Summary -->
                    <div class="order-summary">
                        <h3 class="summary-title">
                            <i class="fas fa-file-invoice-dollar"></i> Order Summary
                        </h3>

                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span id="subTotalValue">₹<%= order.totalPrice.toFixed(2) %></span>
                        </div>

                        <% if (order.discount> 0) { %>
                            <div class="summary-row discount-row">
                                <span>Discount</span>
                                <span>-₹<%= order.discount.toFixed(2) %></span>
                            </div>
                            <% } %>

                                <% if (order.couponApplied) { %>
                                    <div class="summary-row coupon-row">
                                        <span>Coupon Discount</span>
                                        <span class="coupon-applied">
                                            -₹<%= order.couponApplied.amount ? order.couponApplied.amount.toFixed(2)
                                                : "0.00" %>
                                        </span>
                                    </div>
                                    <% } %>

                                        <div class="summary-row">
                                            <span>Shipping</span>
                                            <span>Free</span>
                                        </div>

                                        <div id="finalAmount" class="summary-row total-row">
                                            <span>Total Amount</span>
                                            <span id="finalAmountValue">₹<%= order.finalAmount.toFixed(2) %></span>
                                        </div>

                                        <!-- Payment Details in Summary -->
                                        <div class="payment-summary">
                                            <div class="payment-summary-row">
                                                <span class="payment-label">Payment Method:</span>
                                                <span class="payment-value">
                                                    <% if (order.paymentMethod==='COD' ) { %>
                                                        <i class="fas fa-money-bill-wave payment-method-icon"></i> Cash
                                                        on Delivery
                                                        <% } else if (order.paymentMethod==='RPAY' ) { %>
                                                            <i class="fas fa-credit-card payment-method-icon"></i>
                                                            Online Payment
                                                            <% } else if (order.paymentMethod==='Wallet' ) { %>
                                                                <i class="fas fa-wallet payment-method-icon"></i> Wallet
                                                                <% } %>
                                                </span>
                                            </div>

                                            <% if (order.paymentStatus) { %>
                                                <div class="payment-summary-row">
                                                    <span class="payment-label">Payment Status:</span>
                                                    <span
                                                        class="payment-value payment-<%= order.paymentStatus.toLowerCase() %>">
                                                        <%= order.paymentStatus %>
                                                    </span>
                                                </div>
                                                <% if (order.paymentStatus === 'Failed' && order.paymentMethod === 'RPAY') { %>
                                                    <div class="payment-summary-row mt-3">
                                                        <a href="/paymentFaildRetry?orderId=<%= order.orderId %>" class="btn btn-warning" style="width: 100%;"><i class="fas fa-redo-alt"></i> Retry Payment</a>
                                                    </div>
                                                <% } %>
                                                <% } %>

                                                    <% if (order.invoiceDate) { %>
                                                        <div class="payment-summary-row">
                                                            <span class="payment-label">Invoice Date:</span>
                                                            <span class="payment-value">
                                                                <%= new
                                                                    Date(order.invoiceDate).toLocaleDateString('en-US',
                                                                    { year: 'numeric' , month: 'short' , day: 'numeric'
                                                                    }) %>
                                                            </span>
                                                        </div>
                                                        <% } %>
                                        </div>
                    </div>

                    <!-- Delivery Address -->
                    <div class="delivery-address">
                        <h3 class="section-title">
                            <i class="fas fa-map-marker-alt"></i> Delivery Address
                        </h3>

                        <div class="address-info">
                            <div class="address-type">
                                <i class="fas fa-home"></i>
                                <%= order.address.addressType %>
                            </div>

                            <div class="address-details">
                                <div class="recipient-name">
                                    <%= order.address.name %>
                                </div>
                                <div class="address-line">
                                    <%= order.address.street %>
                                </div>
                                <div class="address-line">
                                    <%= order.address.city %>, <%= order.address.state %>
                                </div>
                                <div class="address-line">
                                    <%= order.address.country %> - <%= order.address.pincode %>
                                </div>
                                <div class="contact-info">
                                    <div class="phone">
                                        <i class="fas fa-phone"></i>
                                        <%= order.address.phone %>
                                    </div>
                                    <% if (order.address.altPhone) { %>
                                        <div class="alt-phone">
                                            <i class="fas fa-phone-alt"></i>
                                            <%= order.address.altPhone %>
                                        </div>
                                        <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="order-actions">
                <a href="/userProfile" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left"></i>
                    <span class="btn-text">Back</span>
                </a>

                <!-- Invoice button always visible -->

                <% if (order.status !=='cancelled'&& order.status!=='Delivered'&&order.status!=='returnRequested'
                    &&order.status!=='returned'&&order.status!=='reutrnRejected' && order.status !== 'Failed') { %>
                    <a class="btn btn-invoice btn-lg btn-danger" href="#"
                        onclick="confirmCancelOrder('<%= order.orderId %>')">
                        <span class="btn-text">Cancel Order</span>
                    </a>
                    <% }else if(order.status==='Delivered'){ %>
                    <a class="btn btn-invoice btn-lg btn-warning" href="#"
                        onclick="returnOrder('<%= order.orderId %>')">
                        <span class="btn-text">Return Order</span>
                    </a>
                        <% } %>
            </div>
        </div>

        <script>
            window.ORDER_CONFIG = {
                status: '<%= order.status %>'
            };
        </script>
        <script src="/js/user/orderDetailPages.js"></script>
</body>

</html>