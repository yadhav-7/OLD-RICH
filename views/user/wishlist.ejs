<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Wishlist - Green & White Theme</title>
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%- include('../../views/partials/user/header',{title:'Wishlist'}) %>
        <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">

        <link rel="stylesheet" href="/user/wishlist.css">
</head>

<body>

    <div class="container">
        <div class="wishlist-header">
            <h1><i class="fas fa-heart"></i> Your Wishlist
                <% if(wishList && wishList.products && wishList.products.length> 0) { %>
                    <span class="item-count">
                        <%= wishList.products.length %>
                    </span>
                    <% } %>
            </h1>
            <a href="/shop" class="continue-shopping"><i class="fas fa-arrow-left"></i> Continue Shopping</a>
        </div>

        <% if(!wishList || !wishList.products || wishList.products.length===0) { %>
            <div class="wishlist-container">
                <div class="empty-wishlist">
                    <i class="fas fa-heart empty-wishlist-icon"></i>
                    <h2>Your wishlist is empty</h2>
                    <p>You haven't added any items to your wishlist yet. Start browsing to find products you love!</p>
                    <a href="/shop" class="continue-shopping"><i class="fas fa-store"></i> Start Shopping</a>
                </div>
            </div>
            <% } else { %>
                <div class="wishlist-container">
                    <div class="loading-overlay">
                        <div class="loading-spinner"></div>
                    </div>

                    <table class="wishlist-table">
                        <thead>
                            <tr>
                                <th style="width: 50%; min-width: 300px;">Product</th>
                                <th style="width: 20%; min-width: 120px;">Price</th>
                                <th style="width: 20%; min-width: 120px;">Stock</th>
                                <th style="width: 15%; min-width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% wishList.products.forEach((product)=> { %>
                                <tr>
                                    <td data-label="Product">
                                        <div class="product-cell">
                                            <% if(product.productId?.productImage && product.productId.productImage[0])
                                                { %>
                                                <a href="/productDetails?productId=<%= product.productId._id%>">
                                                    <img src="<%= product.productId.productImage[0] %>"
                                                        class="product-image" alt="<%= product.productId.productName %>"
                                                        onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                    <div class="product-image-placeholder" style="display: none;">
                                                        <i class="fas fa-image"></i> Image not available
                                                    </div>
                                                </a>

                                                <% } else { %>
                                                    <div class="product-image-placeholder">
                                                        <i class="fas fa-image"></i> No image
                                                    </div>
                                                    <% } %>
                                                        <div class="product-info">
                                                            <div class="product-name">
                                                                <a href="/productDetails?productId=<%= product.productId._id %>"
                                                                    style="text-decoration: none;">
                                                                    <%= product.productId?.productName %>
                                                                </a>
                                                            </div>
                                                            <% if(product.productId?.description) { %>
                                                                <div class="product-description"
                                                                    style="font-size: 14px; color: var(--dark-gray);">
                                                                    <%= product.productId.description.substring(0, 50)
                                                                        %>...
                                                                </div>
                                                                <% } %>
                                                        </div>
                                        </div>
                                    </td>

                                    <td data-label="Price" class="product-price">
                                        ₹<%= product.productId?.variants && product.productId.variants.length> 0 ?
                                            product.productId.variants[0].salePrice.toFixed(2) : 'N/A' %>
                                    </td>

                                    <td data-label="Status">
                                        <% if(product.productId?.status==='Available' ) { %>
                                            <span class="product-stock in-stock">
                                                <i class="fas fa-check-circle"></i> In Stock
                                            </span>
                                            <% } else if(product.productId?.status==='out of stock' ) { %>
                                                <span class="product-stock out-of-stock">
                                                    <i class="fas fa-times-circle"></i> Out of Stock
                                                </span>
                                                <% } else { %>
                                                    <span class="product-stock">
                                                        <i class="fas fa-info-circle"></i>
                                                        <%= product.productId?.status %>
                                                    </span>
                                                    <% } %>
                                    </td>

                                    <td data-label="Actions">
                                        <div class="action-buttons">
                                            <button class="add-to-cart-btn"
                                                data-product-id="<%= product.productId?._id %>"
                                                data-product-variants='<%- JSON.stringify(product.productId?.variants || []) %>'
                                                <%=product.productId?.status !=='Available' ? 'disabled' : '' %>>
                                                <i class="fas fa-cart-plus"></i> Add to Cart
                                            </button>

                                            <button class="remove-btn" data-product-id="<%= product.productId?._id %>">
                                                <i class="fas fa-trash-alt"></i> Remove
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
    </div>

    <script src="/js/user/wishlist.js"></script>
</body>


</html>