<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register | Old Money Outfits</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">

  <link rel="stylesheet" href="/user/register.css">
</head>

<body>
  <div class="register-wrapper">
    <!-- Brand Information Section -->
    <div class="brand-section">
      <div class="brand-logo">
        <i class="fas fa-crown"></i>
        <h1>Old Money Outfits</h1>
      </div>
      <div id="brandImageLogo">
        <img src="/userLogo/Gemini_Generated_Image_6n51zl6n51zl6n51.png" alt="Old Money Outfits Logo">
      </div>
      <p class="brand-tagline">
        Timeless elegance for the modern gentleman. Our collections embody sophistication, quality, and the enduring
        style of classic menswear.
      </p>
      <ul class="brand-features">
        <li><i class="fas fa-check-circle"></i> Premium quality fabrics</li>
        <li><i class="fas fa-check-circle"></i> Timeless designs</li>
        <li><i class="fas fa-check-circle"></i> Expert craftsmanship</li>
        <li><i class="fas fa-check-circle"></i> Exclusive collections</li>
      </ul>
    </div>

    <!-- Register Form Section -->
    <div class="register-container">
      <h2>Register</h2>

      <!-- Display server-side error message -->
      <% if(typeof message!=='undefined' ) {%>
        <div class="alert alert-danger" role="alert">
          <%=message %>
        </div>
        <% } %>

          <form class="register-form" id="register-form" action="/register" method="POST" novalidate>
            <!-- FULL NAME -->
            <div class="form-group">
              <label for="fullname">FULL NAME</label>
              <input type="text" id="fullname" name="username" placeholder="Enter your full name"
                aria-describedby="nameError" required minlength="3" maxlength="50">
              <span id="register-error1" class="error-message" aria-live="polite"></span>
            </div>

            <!-- EMAIL -->
            <div class="form-group">
              <label for="email">EMAIL ADDRESS</label>
              <input type="email" id="email" name="email" placeholder="Enter your email address"
                aria-describedby="emailError" required>
              <span id="register-error2" class="error-message" aria-live="polite"></span>
            </div>

            <!-- PHONE -->
            <div class="form-group">
              <label for="phone">PHONE</label>
              <input type="tel" id="phone" name="phone" placeholder="Enter your 10-digit phone number"
                aria-describedby="phoneError" required pattern="[0-9]{10}" maxlength="10">
              <span id="register-error3" class="error-message" aria-live="polite"></span>
            </div>

            <!-- PASSWORD -->
            <div class="form-group">
              <label for="password">PASSWORD</label>
              <div class="password-container">
                <input type="password" id="password" name="password" placeholder="Enter your password"
                  aria-describedby="passwordError" required minlength="8">
                <button type="button" class="toggle-password" id="togglePassword">
                  <i class="far fa-eye"></i>
                </button>
              </div>
              <div class="strength-meter">
                <div id="strength-meter-fill" class="strength-meter-fill"></div>
              </div>
              <div class="password-requirements">
                <ul class="list-unstyled">
                  <li id="length-requirement">At least 8 characters</li>
                  <li id="number-requirement">Contains a number</li>
                  <li id="letter-requirement">Contains a letter</li>
                  <li id="special-requirement">Contains a special character (optional)</li>
                </ul>
              </div>
              <span id="register-error4" class="error-message" aria-live="polite"></span>
            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="form-group">
              <label for="confirm-password">CONFIRM PASSWORD</label>
              <div class="password-container">
                <input type="password" id="confirm-password" name="cpassword" placeholder="Confirm your password"
                  aria-describedby="confirmPasswordError" required>

              </div>
              <span id="register-error5" class="error-message" aria-live="polite"></span>
            </div>

            <!-- REGISTER BUTTON -->
            <button type="submit" id="registerBtn" class="btn btn-success w-100 py-2">
              <span id="btnText">REGISTER</span>
              <span id="btnLoader" class="loader" style="display: none; margin-left: 8px;"></span>
            </button>
          </form>

          <!-- GOOGLE BUTTON -->
          <div class="google-register">
            <a href="/auth/google/register" class="d-flex align-items-center justify-content-center">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none"
                style="vertical-align: middle; margin-right: 8px;">
                <path
                  d="M17.64 9.2045C17.64 8.5663 17.5827 7.9527 17.4764 7.3635H9V10.845H13.8436C13.635 11.97 13.0009 12.9231 12.0477 13.5613V15.8195H14.9564C16.6582 14.2526 17.64 11.9456 17.64 9.2045Z"
                  fill="#4285F4" />
                <path
                  d="M9 18C11.43 18 13.4673 17.1941 14.9564 15.8195L12.0477 13.5613C11.2418 14.1013 10.2109 14.4204 9 14.4204C6.65591 14.4204 4.67182 12.8372 3.96409 10.71H0.957275V13.0418C2.43818 15.9831 5.48182 18 9 18Z"
                  fill="#34A853" />
                <path
                  d="M3.96409 10.71C3.78409 10.17 3.68182 9.5931 3.68182 9C3.68182 8.4069 3.78409 7.83 3.96409 7.29V4.9582H0.957273C0.347727 6.1731 0 7.5477 0 9C0 10.4523 0.347727 11.8269 0.957273 13.0418L3.96409 10.71Z"
                  fill="#FBBC05" />
                <path
                  d="M9 3.57955C10.3214 3.57955 11.5077 4.03364 12.4405 4.92545L15.0218 2.34409C13.4632 0.891818 11.4259 0 9 0C5.48182 0 2.43818 2.01682 0.957275 4.95818L3.96409 7.29C4.67182 5.16273 6.65591 3.57955 9 3.57955Z"
                  fill="#EA4335" />
              </svg>
              REGISTER WITH GOOGLE
            </a>
          </div>

          <p class="text-center">
            ALREADY HAVE AN ACCOUNT? <a href="/login">LOGIN</a>
          </p>
    </div>
  </div>
  <script src="/js/user/register.js"></script>
</body>

</html>
</body>

</html>