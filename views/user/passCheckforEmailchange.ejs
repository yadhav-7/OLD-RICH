<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify Password</title>
  <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">
  <link rel="stylesheet" href="/user/passCheckforEmailchange.css">
</head>

<body>
  <div class="container">
    <form onsubmit="return verifyPassword()" action="/passCheckforEmailchange" method="POST">
      <h2>Verify Your Password</h2>

      <div class="form-group">
        <input name="password" type="password" id="passwordInput" placeholder=" " />
        <label for="passwordInput">Enter your password</label>
      </div>

      <% if (typeof message !=='undefined' ) { %>
        <div class="message-box">
          <%= message %>
        </div>
        <% } else { %>
          <div class="message-box"></div>
          <% } %>

            <div id="errorMessage" class="error">Please enter your password</div>

            <button type="submit">Continue</button>

            <p>Back to <a href="/userProfile">Profile</a></p>
    </form>
  </div>

  <script src="/js/user/passCheckforEmailchange.js"></script>
</body>

</html>