<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart - Green & White Theme</title>
    <!-- SweetAlert2 CSS (optional, included with JS usually) -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="icon" href="/userTitleLogo/Gemini_Generated_Image_kb9bqfkb9bqfkb9b (1).png" type="image/png">
    <link rel="stylesheet" href="/user/cart.css">


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
    <%- include('../../views/partials/user/header', {title: 'Your Cart' }) %>
        <div class="container">
            <div class="cart-header">
                <h1><i class="fas fa-shopping-cart"></i> Your Shopping Cart
                    <% if(userCart && userCart.length> 0) { %>
                        <span class="item-count">
                            <%= userCart.filter(item=> {
                                const product = item.productId;
                                const category = product?.category;
                                let variantStock = 0;

                                if (product?.variants?.length) {
                                const matchedVariant = product.variants.find(v =>
                                v.size === item.size && v.color === item.color
                                );
                                if (matchedVariant) {
                                variantStock = matchedVariant.quantity;
                                }
                                }

                                const isBlocked = product?.isBlocked;
                                const categoryListed = category?.isListed;

                                return !(variantStock <= 0 || isBlocked || categoryListed===false); }).length %>
                        </span>
                        <% } %>
                </h1>
                <a href="/shop" class="continue-shopping"><i class="fas fa-arrow-left"></i> Continue Shopping</a>
            </div>

            <% if(!userCart || userCart.length < 1) { %>
                <div class="cart-items">
                    <div class="empty-cart">
                        <i class="fas fa-shopping-cart empty-cart-icon"></i>
                        <h2>Your cart is empty</h2>
                        <p>Looks like you haven't added any items to your cart yet. Start shopping to find amazing
                            products!</p>
                        <a href="/shop" class="continue-shopping"><i class="fas fa-store"></i> Start Shopping</a>
                    </div>
                </div>
                <% } else { %>
                    <% let subtotal=0; let availableItemsCount=0; userCart.forEach(item=> {
                        const product = item.productId;
                        const category = product?.category;

                        let variantStock = 0;

                        if (product?.variants?.length) {
                        const matchedVariant = product.variants.find(v => v.size === item.size);
                        if (matchedVariant) variantStock = matchedVariant.quantity;
                        }

                        const isBlocked = product?.isBlocked;
                        const categoryListed = category?.isListed;
                        const isAvailable = !(variantStock <= 0 || isBlocked || categoryListed===false); if
                            (isAvailable) { subtotal +=item.quantity * item.price; availableItemsCount++; } }); const
                            tax=0; const total=subtotal + tax; %>


                            <div class="cart-container">
                                <div class="cart-items">
                                    <table class="cart-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 40%;">Product</th>
                                                <th style="width: 15%;">Price</th>
                                                <th style="width: 20%;">Quantity</th>
                                                <th style="width: 15%;">Total</th>
                                                <th style="width: 10%;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% userCart.forEach(function(item, index) { const product=item.productId;
                                                const category=product?.category; let variantStock=0; if
                                                (product?.variants?.length) { const
                                                matchedVariant=product.variants.find(v=> v.size === item.size);
                                                if (matchedVariant) {
                                                variantStock = matchedVariant.quantity;
                                                }
                                                }

                                                const isBlocked = product?.isBlocked;
                                                const categoryListed = category?.isListed;

                                                const isAvailable = !(variantStock <= 0 || isBlocked ||
                                                    categoryListed===false); const itemTotal=item.quantity * item.price;
                                                    %>

                                                    <% if (isAvailable) { %>
                                                        <!-- Available Product Row -->
                                                        <tr>
                                                            <td data-label="Product">
                                                                <div class="product-cell">
                                                                    <% if (product?.productImage?.[0]) { %>
                                                                        <img src="<%= product.productImage[0] %>"
                                                                            class="product-image"
                                                                            alt="<%= product.productName || 'Product image' %>"
                                                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                                        <div class="product-image-placeholder"
                                                                            style="display: none;">
                                                                            <i class="fas fa-image"></i>
                                                                        </div>
                                                                        <% } else { %>
                                                                            <div class="product-image-placeholder">
                                                                                <i class="fas fa-image"></i>
                                                                            </div>
                                                                            <% } %>

                                                                                <div class="product-info">
                                                                                    <div class="product-name">
                                                                                        <a
                                                                                            href="/product/<%= product._id %>">
                                                                                            <%= product.productName
                                                                                                || 'Product not found'
                                                                                                %>
                                                                                        </a>
                                                                                    </div>

                                                                                    <div class="product-variant">
                                                                                        <% if(item.size) { %>
                                                                                            <span>Size: <%= item.size %>
                                                                                            </span>
                                                                                            <% } %>
                                                                                                <% if(item.color) { %>
                                                                                                    <span>Color: <%=
                                                                                                            item.color
                                                                                                            %></span>
                                                                                                    <% } %>
                                                                                    </div>
                                                                                </div>
                                                                </div>
                                                            </td>

                                                            <td data-label="Price" class="price-cell">
                                                                ₹<%= item.price.toFixed(2) %>
                                                            </td>

                                                            <td data-label="Quantity">
                                                                <div class="quantity-control">
                                                                    <button class="quantity-btn decrease"
                                                                        data-id="<%= item._id %>"
                                                                        data-index="<%= index %>">
                                                                        <i class="fas fa-minus"></i>
                                                                    </button>
                                                                    <input type="number" class="quantity-input"
                                                                        id="itemSelectedQuantity<%= index %>"
                                                                        value="<%= item.quantity %>" min="1"
                                                                        data-id="<%= item._id %>"
                                                                        data-index="<%= index %>" readonly>
                                                                    <button class="quantity-btn increase"
                                                                        data-id="<%= item._id %>"
                                                                        data-index="<%= index %>">
                                                                        <i class="fas fa-plus"></i>
                                                                    </button>
                                                                </div>
                                                            </td>

                                                            <td data-label="Total" class="price-cell"
                                                                id="total-<%= index %>">
                                                                ₹<%= item.totalPrice?.toFixed(2) %>
                                                            </td>

                                                            <td data-label="Action">
                                                                <button type="submit" class="remove-btn"
                                                                    id="remove-product-btn"
                                                                    data-product-id="<%= item._id %>">
                                                                    <i class="fas fa-trash-alt btn-icon"></i> Remove
                                                                </button>
                                                            </td>
                                                        </tr>
                                                        <% } else { %>

                                                            <tr class="unavailable-row">
                                                                <td colspan="5">
                                                                    <div class="product-cell">
                                                                        <% if (product?.productImage?.[0]) { %>
                                                                            <img src="<%= product.productImage[0] %>"
                                                                                class="product-image"
                                                                                style="width: 60px; height: 60px;"
                                                                                alt="<%= product.productName || 'Product image' %>">
                                                                            <% } else { %>
                                                                                <div class="product-image-placeholder">
                                                                                    <i class="fas fa-image"></i>
                                                                                </div>
                                                                                <% } %>

                                                                                    <div class="product-info">
                                                                                        <div class="product-name">
                                                                                            <%= product?.productName
                                                                                                || 'Product' %>
                                                                                                <span
                                                                                                    class="unavailable-badge">Unavailable</span>
                                                                                        </div>

                                                                                        <div class="product-variant">
                                                                                            <% if(item.size) { %>
                                                                                                <span>Size: <%=
                                                                                                        item.size %>
                                                                                                </span>
                                                                                                <% } %>
                                                                                                    <% if(item.color) {
                                                                                                        %>
                                                                                                        <span>Color: <%=
                                                                                                                item.color
                                                                                                                %>
                                                                                                        </span>
                                                                                                        <% } %>
                                                                                        </div>

                                                                                        <div
                                                                                            class="unavailable-reasons">
                                                                                            <ul>
                                                                                                <% if (variantStock <=0)
                                                                                                    { %>
                                                                                                    <li>Selected variant
                                                                                                        is out of stock
                                                                                                    </li>
                                                                                                    <% } %>
                                                                                                        <% if
                                                                                                            (isBlocked)
                                                                                                            { %>
                                                                                                            <li>Product
                                                                                                                has been
                                                                                                                blocked
                                                                                                                by admin
                                                                                                            </li>
                                                                                                            <% } %>
                                                                                                                <% if
                                                                                                                    (categoryListed===false)
                                                                                                                    { %>
                                                                                                                    <li>Category
                                                                                                                        is
                                                                                                                        currently
                                                                                                                        unlisted
                                                                                                                    </li>
                                                                                                                    <% }
                                                                                                                        %>
                                                                                            </ul>
                                                                                        </div>
                                                                                    </div>
                                                                    </div>

                                                                    <button type="submit" class="remove-btn"
                                                                        id="remove-product-btn"
                                                                        data-product-id="<%= item._id %>">
                                                                        <i class="fas fa-trash-alt btn-icon"></i> Remove
                                                                    </button>

                                                                </td>
                                                            </tr>
                                                            <% } %>
                                                                <% }); %>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="cart-summary">
                                    <h2 class="summary-title">
                                        Order Summary
                                        <span>(<%= availableItemsCount %>
                                                <%= availableItemsCount===1 ? 'item' : 'items' %>)</span>
                                    </h2>
                                    <div class="summary-row">
                                        <span>Subtotal</span>
                                        <span id="subtotal">₹<%= total.toFixed(2) %></span>
                                    </div>
                                    <div class="summary-row">
                                        <span>Shipping</span>
                                        <span>Free</span>
                                    </div>
                                    <div class="summary-row">
                                        <span>Tax (0%)</span>
                                        <span id="tax">₹<%= tax.toFixed(2) %></span>
                                    </div>
                                    <div class="summary-row total-row">
                                        <span>Total</span>
                                        <span id="totalOfCart">₹<%= total.toFixed(2) %></span>
                                    </div>

                                    <button class="checkout-btn" id="proceed-to-checkout" <%=availableItemsCount===0
                                        ? 'disabled' : '' %>>
                                        <i class="fas fa-lock"></i> Proceed to Checkout
                                    </button>

                                    <% if (availableItemsCount===0) { %>
                                        <div style="color: var(--error-red); text-align: center; margin-top: 10px;">
                                            Your cart contains no available items
                                        </div>
                                        <% } %>

                                            <div class="secure-checkout">
                                                <i class="fas fa-shield-alt"></i> Secure Checkout
                                            </div>

                                            <div
                                                style="margin-top: 20px; font-size: 13px; color: var(--dark-gray); text-align: center;">
                                                <i class="fas fa-undo-alt"></i> Easy returns within 30 days
                                            </div>
                                </div>
                            </div>
                         
        </div>

        <% } %>
            </div>

            <script src="/js/user/cart.js"></script>
</body>

</html>