<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Report Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="icon" href="/adminTitleIcon/Gemini_Generated_Image_19c76t19c76t19c7.png" type="image/png">
 <link rel="stylesheet" href="/admin/salesReport.css">
   
</head>

<body>
    <%- include('../../views/partials/admin/adminHeaders', {title: 'adminHeader-page' }) %>
        <%- include('../../views/partials/admin/adminSidebar', {title: 'adminSidebar-page' }) %>


            <div class="container" id="content-wraper">
                <div class="dashboard-header">
                    <div class="header-title">
                        <i class="fas fa-chart-pie"></i>
                        <span>Sales Analytics</span>
                    </div>
                    <div class="header-actions">
                        <button class="toggle-filters-btn" id="toggle-filters">
                            <i class="fas fa-filter"></i>
                            <span>Show Filters</span>
                        </button>
                        <button class="action-btn pdf-btn" id="export-pdf">
                            <i class="far fa-file-pdf"></i>
                            Export PDF
                        </button>
                        <button class="action-btn excel-btn" id="export-excel">
                            <i class="far fa-file-excel"></i>
                            Export Excel
                        </button>
                    </div>
                </div>

                <div class="dashboard-content">
                    <!-- Modern Filter Card -->
                    <div class="filter-card collapsed" id="filter-card">
                        <div class="filter-header" id="filter-header">
                            <div class="filter-header-left">
                                <i class="fas fa-calendar-alt"></i>
                                <h2>Filter Report by Date</h2>
                            </div>
                            <div class="filter-toggle-icon">
                                <i class="fas fa-chevron-down"></i>
                            </div>
                        </div>

                        <div class="filter-content">
                            <!-- Single Row Filter Layout -->
                            <div class="filter-row">
                                <div class="filter-group">
                                    <label for="preset-select"><i class="fas fa-clock"></i> Quick Presets</label>
                                    <select class="preset-select" id="preset-select">
                                        <option value="" disabled selected>Select Date</option>
                                        <option value="today">Today</option>
                                        <option value="week">Last 7 Days</option>
                                        <option value="month">Last 30 Days</option>
                                        <option value="year">Last Year</option>
                                        <option value="custom">Custom Range</option>
                                    </select>
                                </div>

                                <div class="filter-group" id="custom-date-group" style="display: none;">
                                    <label><i class="fas fa-calendar-day"></i> Custom Date Range</label>
                                    <div class="date-range-container">
                                        <div class="date-input-wrapper">
                                            <i class="fas fa-calendar"></i>
                                            <input type="date" class="date-input" id="start-date">
                                        </div>
                                        <span>to</span>
                                        <div class="date-input-wrapper">
                                            <i class="fas fa-calendar"></i>
                                            <input type="date" class="date-input" id="end-date">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="active-filters" id="active-filters">
                                <!-- Active filters will appear here -->
                            </div>

                            <div class="filter-actions">
                                <button class="generate-btn" id="generate-report">
                                    <i class="fas fa-sync-alt"></i>
                                    Apply Filters & Generate Report
                                </button>
                                <button class="reset-btn" id="reset-filters">
                                    <i class="fas fa-redo"></i>
                                    Reset
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Loading Spinner -->
                    <div class="loading-spinner" id="loading-spinner">
                        <i class="fas fa-spinner fa-spin fa-2x" style="color: var(--primary);"></i>
                        <p style="margin-top: 10px;">Loading sales data...</p>
                    </div>

                    <!-- Stats Grid -->
                    <div class="stats-grid" id="stats-grid">
                        <div class="stat-card">
                            <h3>Overall Sales Count</h3>
                            <div class="stat-value" id="totalSalesCount">
                                <%= totalSalesCount %>
                            </div>
                            <div class="stat-trend trend-up"></div>
                        </div>
                        <div class="stat-card">
                            <h3>Overall Order Amount</h3>
                            <div class="stat-value" id="OverallOrderAmount">₹<%= OverallOrderAmount.toFixed(2) %>
                            </div>
                            <div class="stat-trend trend-up"></div>
                        </div>
                        <div class="stat-card">
                            <h3>Overall Discount</h3>
                            <div class="stat-value" id="OverallDiscount">₹<%= OverallDiscount.toFixed(2) %>
                            </div>
                            <div class="stat-trend trend-down"></div>
                        </div>
                        <div class="stat-card">
                            <h3>Coupon Usage</h3>
                            <div class="stat-value" id="CouponUsage">
                                <%= CouponUsage %>
                            </div>
                            <div class="stat-trend trend-up"></div>
                        </div>
                        <div class="stat-card">
                            <h3>Coupon Discount</h3>
                            <div class="stat-value" id="CouponDisCount">
                                <%= CouponDisCount.toFixed(2) %>
                            </div>
                            <div class="stat-trend trend-up"></div>
                        </div>
                        <div class="stat-card">
                            <h3>Returned Amount</h3>
                            <div class="stat-value" id="returnedAmount">
                                <%= returnedAmount.toFixed(2) %>
                            </div>
                            <div class="stat-trend trend-up"></div>
                        </div>
                        <div class="stat-card">
                            <h3>Return Count</h3>
                            <div class="stat-value" id="returnCount">
                                <%= returnCount %>
                            </div>
                            <div class="stat-trend trend-up"></div>
                        </div>
                        <div class="stat-card">
                            <h3>Cancelled Refund</h3>
                            <div class="stat-value" id="cancelledAmount">
                                <%= cancelledAmount.toFixed(2) %>
                            </div>
                            <div class="stat-trend trend-up"></div>
                        </div>
                        <div class="stat-card">
                            <h3>Cancelled Count</h3>
                            <div class="stat-value" id="cancelledCount">
                                <%= cancelledCount %>
                            </div>
                            <div class="stat-trend trend-up"></div>
                        </div>
                    </div>

                    <!-- Report Section -->
                    <% if (orders && orders.length> 0) { %>
                        <div class="report-section" id="report-section">
                            <div class="section-header">
                                <h3>Detailed Sales Report</h3>
                            </div>
                            <div class="report-table">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>No</th>
                                            <th>Date</th>
                                            <th>Customer</th>
                                            <th>Amount</th>
                                            <th>Discount</th>
                                            <th>Coupon</th>
                                            <th>Status</th>
                                            <!-- <th>Refund for<br>cancell/return</th> -->
                                             <th>Detailed view</th>
                                        </tr>
                                    </thead>
                                    <tbody id="sales-table-body">
                                        <% orders.forEach((order,index)=> { %>
                                            <tr>
                                                 <td>
                                                    <%= index+1 %>
                                                </td>
                                                <td>
                                                    <%= new Date(order.createdOn).toLocaleDateString('en-IN', {
                                                        day: '2-digit' , month: 'short' , year: 'numeric' }) %>
                                                </td>
                                                <td>
                                                    <%= order.userId?.username %>
                                                </td>
                                                <td>
                                                    <%= order.finalAmount %>
                                                </td>
                                                <td><span class="discount-badge">
                                                        <%= order.discount %>
                                                    </span></td>
                                                <% if (order.couponApplied?.applied) { %>
                                                    <td><span class="coupon-badge">
                                                            <%= order.couponApplied?.code %>
                                                        </span></td>
                                                    <% } else { %>
                                                        <td><span class="coupon-badge-notused">None</span></td>
                                                        <% } %>
                                                            <td class="status <%= order.status.toLowerCase() %>">
                                                                <%= order.status %>
                                                            </td>
                                                      

                                                            <td>
                                                              <a href="/admin/orderDetails?orderId=<%= order.orderId %>" class="btn btn-sm view-btn">
    <i class="bi bi-eye me-1"></i> View
</a>


                                                            </td>

                                            <% }) %> 
                                    </tbody>
                                </table>
                              

                                <div class="pagination">
                                    <% if(currentPage>1){ %>
                                        <button onclick="pagination('previous')" id="prevBtn"
                                            class="page-btn prev">&laquo;</button>
                                        <% } %>
                                            <button id="currentPage" class="page-btn active">
                                                <%= currentPage %>
                                            </button>

                                            <% if (currentPage<totalPage) { %>
                                                <button onclick="pagination('next')" id="nextBtn"
                                                    class="page-btn next">&raquo;</button>

                                                <% } %>
                                </div>



                            </div>
                        </div>
                        <% } else { %>
                            <div class="report-section" id="report-section" style="display: none;">
                                <div class="section-header">
                                    <h3>Detailed Sales Report</h3>
                                </div>
                                <div class="report-table">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Order ID</th>
                                                <th>Customer</th>
                                                <th>Amount</th>
                                                <th>Discount</th>
                                                <th>Coupon</th>
                                                <th>Status</th>
                                                <th>Refund for<br>cancell/return</th>
                                            </tr>
                                        </thead>
                                        <tbody id="sales-table-body">
                                            <!-- Dynamic content will be loaded here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <% } %>
                </div>
            </div>

            <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
            <script>
                // Set default date inputs to today
                let startDate
                let endDate
                const today = new Date();
                const startOfToday = new Date(today);

                document.getElementById('start-date').valueAsDate = startOfToday;
                document.getElementById('end-date').valueAsDate = today;

                // Filter state
                let currentFilter = {
                    preset: '',
                    startDate: formatDate(today),
                    endDate: formatDate(today)
                }

                // Filter toggle functionality
                const filterCard = document.getElementById('filter-card');
                const filterHeader = document.getElementById('filter-header');
                const toggleFiltersBtn = document.getElementById('toggle-filters');
                const presetSelect = document.getElementById('preset-select');
                const customDateGroup = document.getElementById('custom-date-group');
                const startDateInput = document.getElementById('start-date');
                const endDateInput = document.getElementById('end-date');
                const loadingSpinner = document.getElementById('loading-spinner');
                const statsGrid = document.getElementById('stats-grid');
                const reportSection = document.getElementById('report-section');

                // Initialize filters as collapsed
                filterCard.classList.add('collapsed');
                filterCard.classList.remove('expanded');
                toggleFiltersBtn.querySelector('span').textContent = 'Show Filters';

                // Toggle filters when header is clicked
                filterHeader.addEventListener('click', function () {
                    toggleFilters();
                });

                // Toggle filters when button is clicked
                toggleFiltersBtn.addEventListener('click', function () {
                    toggleFilters();
                });

                function toggleFilters() {
                    const isCollapsed = filterCard.classList.contains('collapsed');

                    if (isCollapsed) {
                        // Expand filters
                        filterCard.classList.remove('collapsed');
                        filterCard.classList.add('expanded');
                        toggleFiltersBtn.querySelector('span').textContent = 'Hide Filters';
                        toggleFiltersBtn.querySelector('i').className = 'fas fa-times';
                    } else {
                        // Collapse filters
                        filterCard.classList.remove('expanded');
                        filterCard.classList.add('collapsed');
                        toggleFiltersBtn.querySelector('span').textContent = 'Show Filters';
                        toggleFiltersBtn.querySelector('i').className = 'fas fa-filter';
                    }
                }

                // Preset select change
                presetSelect.addEventListener('change', function () {
                    currentFilter.preset = this.value;

                    // Show/hide custom date inputs
                    if (currentFilter.preset === 'custom') {
                        customDateGroup.style.display = 'block'





                        currentFilter.startDate = startDate
                        currentFilter.endDate = endDate
                    } else {
                        customDateGroup.style.display = 'none';
                    }

                    // updateActiveFilters();
                });

                // Date input changes
                startDateInput.addEventListener('change', function () {
                    currentFilter.startDate = this.value;
                    currentFilter.preset = 'custom';
                    presetSelect.value = 'custom';
                    customDateGroup.style.display = 'block';
                    // updateActiveFilters();
                });

                endDateInput.addEventListener('change', function () {
                    currentFilter.endDate = this.value;
                    currentFilter.preset = 'custom';
                    presetSelect.value = 'custom';
                    customDateGroup.style.display = 'block';
                    //updateActiveFilters();
                });

               
                // Format date for display
                function formatDate(date) {
                    return date.toISOString().split('T')[0];
                }

              
                // Format date for display (MM/DD/YYYY)
                function formatDisplayDate(dateString) {
                    const date = new Date(dateString);
                    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                }

                document.getElementById('generate-report').addEventListener('click', async function () {
                    try {
                        // Show loading state
                        if(!currentFilter.preset){
                            Toastify({
    text: "Please select a date!",
    duration: 3000,
    gravity: "top",
    position: "right",
    backgroundColor: "linear-gradient(to right, #ff5f6d, #ffc371)",
    stopOnFocus: true
}).showToast();

                            return
                        }
                        loadingSpinner.classList.add('active');
                        statsGrid.classList.add('loading')
                        reportSection.style.display = 'none'

                        let filterParam = '';
                        let startDate = '';
                        let endDate = '';

                       
                      
                        // Determine filter parameters
                        switch (currentFilter.preset) {
                            case 'today':
                                filterParam = 'Today';
                                break;
                            case 'week':
                                filterParam = 'Last 7 Days';
                                break;
                            case 'month':
                                filterParam = 'Last 30 Days';
                                break;
                            case 'year':
                                filterParam = 'Last Year';
                                break;
                            case 'custom':
                                filterParam = 'custom';
                                startDate = document.getElementById('start-date').value;
                                endDate = document.getElementById('end-date').value;

                                // Validate custom dates
                                let today = new Date();
                                today.setHours(23, 59, 59, 999);

                                let start = new Date(startDate);
                                let end = new Date(endDate);
                                end.setHours(23, 59, 59, 999);

                                if (start > today) {
                                    Toastify({
                                        text: "Start date cannot be in the future!",
                                        duration: 3000,
                                        gravity: "top",
                                        position: "right",
                                        backgroundColor: "linear-gradient(to right, #ff5f6d, #ffc371)",
                                        stopOnFocus: true
                                    }).showToast();
                                    loadingSpinner.classList.remove('active');
                                    statsGrid.classList.remove('loading');
                                    return;
                                }

                                if (end > today) {
                                    Toastify({
                                        text: "End date cannot be in the future!",
                                        duration: 3000,
                                        gravity: "top",
                                        position: "right",
                                        backgroundColor: "linear-gradient(to right, #36d1dc, #5b86e5)",
                                        stopOnFocus: true
                                    }).showToast();
                                    loadingSpinner.classList.remove('active');
                                    statsGrid.classList.remove('loading');
                                    return;
                                }

                                if (start > end) {
                                    Toastify({
                                        text: "Start date should be before end date!",
                                        duration: 3000,
                                        gravity: "top",
                                        position: "right",
                                        backgroundColor: "linear-gradient(to right, #ff512f, #dd2476)",
                                        stopOnFocus: true
                                    }).showToast();
                                    loadingSpinner.classList.remove('active');
                                    statsGrid.classList.remove('loading');
                                    return
                                }
                                break
                        }


                        const response = await fetch(`/admin/salesReport?date=${encodeURIComponent(filterParam)}&startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`, {
                            headers: { 'Accept': 'application/json' }
                        });

                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }

                        const data = await response.json();

                        // Update stats
                        document.getElementById('totalSalesCount').textContent = data.totalSalesCount;
                        document.getElementById('OverallOrderAmount').textContent = '₹' + data.OverallOrderAmount.toFixed(2);
                        document.getElementById('OverallDiscount').textContent = '₹' + data.OverallDiscount.toFixed(2);
                        document.getElementById('CouponUsage').textContent = data.CouponUsage;
                        document.getElementById('CouponDisCount').textContent = data.CouponDisCount.toFixed(2);
                        document.getElementById('returnedAmount').textContent = data.returnedAmount.toFixed(2);
                        document.getElementById('returnCount').textContent = data.returnCount;
                        document.getElementById('cancelledAmount').textContent = data.cancelledAmount.toFixed(2);
                        document.getElementById('cancelledCount').textContent = data.cancelledCount;

                        // Update table
                        const tableBody = document.getElementById('sales-table-body');
                        tableBody.innerHTML = '';

                                let tableNumber = (data.currentPage-1)*5
                                tableNumber+=1
                              
                                let totalRefund = 0;

                        if (data.orders && data.orders.length > 0) {
                         data.orders.forEach(order => {

    let totalRefund = 0; // RESET per order

    const orderDate = new Date(order.createdOn).toLocaleDateString('en-IN', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    });

    // Calculate refund for this order
    if (order.orderedItems && order.orderedItems.length > 0) {
        order.orderedItems.forEach(item => {
            totalRefund += item.reFund || 0;
        });
    }

    const couponBadge = order.couponApplied?.applied
        ? `<span class="coupon-badge">${order.couponApplied.code}</span>`
        : `<span class="coupon-badge-notused">None</span>`;

   
    const row = `
        <tr>
            <td>${tableNumber++}</td>
            <td>${orderDate}</td>
            <td>${order.userId?.username || 'User Not Exists'}</td>
            <td>${order.finalAmount}</td>
            <td><span class="discount-badge">${order.discount || 0}</span></td>
            <td>${couponBadge}</td>
            <td class="status ${order.status.toLowerCase()}">${order.status}</td>
            <td>
                <a href="/admin/orderDetails?orderId=${encodeURIComponent(order.orderId)}" 
                   class="btn btn-sm view-btn">
                   <i class="bi bi-eye me-1"></i> View
                </a>
            </td>
        </tr>
    `;

    tableBody.insertAdjacentHTML('beforeend', row);

});

                            // FIX: Make sure to show the report section after populating data
                            reportSection.style.display = 'block';

                            renderPagination(data.currentPage, data.totalPage);

                        } else {
                            tableBody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 20px;">No orders found for the selected filter</td></tr>';
                            // FIX: Show the report section even when no data
                            reportSection.style.display = 'block';
                        }

                        // Show success toast
                        Toastify({
                            text: `Report loaded successfully!`,
                            duration: 3000,
                            gravity: "top",
                            position: "right",
                            backgroundColor: "#28a745",
                        }).showToast();

                    } catch (error) {
                        console.error('Error fetching sales data:', error);
                        Toastify({
                            text: "Error loading data. Please try again!",
                            backgroundColor: "#dc3545",
                            gravity: "top",
                            position: "right"
                        }).showToast();
                        // FIX: Make sure to show report section even on error
                        reportSection.style.display = 'block';
                    } finally {
                        // Hide loading state
                        loadingSpinner.classList.remove('active');
                        statsGrid.classList.remove('loading');
                    }
                });
                // Reset filters and reload report to initial state
                document.getElementById('reset-filters').addEventListener('click', async function () {
                    try {
                        // Reset filter inputs
                        document.getElementById('start-date').value = '';
                        document.getElementById('end-date').value = '';
                        currentFilter.preset = ''

                        // Show loading state
                        loadingSpinner.classList.add('active');
                        statsGrid.classList.add('loading');
                        reportSection.style.display = 'none';

                        const select = document.getElementById("preset-select");

// Select the placeholder option
select.selectedIndex = 0;

                        // Fetch the **first page** with default filter
                        const response = await fetch(`/admin/salesReport?date=Last 30 Days&page=1`, {
                            headers: { 'Accept': 'application/json' }
                        });

                        if (!response.ok) throw new Error('Network response was not ok');

                        const data = await response.json();

                        // Update stats (same as initial render)
                        document.getElementById('totalSalesCount').textContent = data.totalSalesCount;
                        document.getElementById('OverallOrderAmount').textContent = '₹' + data.OverallOrderAmount.toFixed(2);
                        document.getElementById('OverallDiscount').textContent = '₹' + data.OverallDiscount.toFixed(2);
                        document.getElementById('CouponUsage').textContent = data.CouponUsage;
                        document.getElementById('CouponDisCount').textContent = data.CouponDisCount.toFixed(2);
                        document.getElementById('returnedAmount').textContent = data.returnedAmount.toFixed(2);
                        document.getElementById('returnCount').textContent = data.returnCount;
                        document.getElementById('cancelledAmount').textContent = data.cancelledAmount.toFixed(2);
                        document.getElementById('cancelledCount').textContent = data.cancelledCount;

                        // Update table
                        const tableBody = document.getElementById('sales-table-body');
                        tableBody.innerHTML = ''

                        if (data.orders && data.orders.length > 0) {
                            data.orders.forEach(order => {
                                const orderDate = new Date(order.createdOn).toLocaleDateString('en-IN', {
                                    day: '2-digit',
                                    month: 'short',
                                    year: 'numeric'
                                });

                                let totalRefund = 0;
                                if (order.orderedItems && order.orderedItems.length > 0) {
                                    order.orderedItems.forEach(item => {
                                        totalRefund += item.reFund || 0;
                                    });
                                }

                                const couponBadge = order.couponApplied?.applied
                                    ? `<span class="coupon-badge">${order.couponApplied.code}</span>`
                                    : `<span class="coupon-badge-notused">None</span>`;

                                const refundCell = totalRefund > 0
                                    ? `<td class="refund">${totalRefund}</td>`
                                    : `<td class="refund">—</td>`;

                                const row = `
                    <tr>
                        <td>${orderDate}</td>
                        <td>${order.orderId}</td>
                        <td>${order.userId?.username || 'Guest'}</td>
                        <td>${order.finalAmount}</td>
                        <td><span class="discount-badge">${order.discount}</span></td>
                        <td>${couponBadge}</td>
                        <td class="status ${order.status.toLowerCase()}">${order.status}</td>
                        ${refundCell}
                    </tr>
                `
                                tableBody.insertAdjacentHTML('beforeend', row);
                            });

                            // Reset pagination to first page
                            renderPagination(1, data.totalPage);
                        } else {
                            tableBody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 20px;">No orders found</td></tr>';
                        }

                        reportSection.style.display = 'block';

                        Toastify({
                            text: "Report reset to initial state.",
                            duration: 3000,
                            gravity: "top",
                            position: "right",
                            backgroundColor: "#28a745",
                        }).showToast();

                    } catch (error) {
                        console.error('Error resetting report:', error);
                        Toastify({
                            text: "Error resetting report. Please try again!",
                            backgroundColor: "#dc3545",
                            gravity: "top",
                            position: "right"
                        }).showToast();
                    } finally {
                        loadingSpinner.classList.remove('active');
                        statsGrid.classList.remove('loading');
                    }
                });

                document.getElementById('export-pdf').addEventListener('click', function () {
                  
                    switch (currentFilter.preset) {
                        case 'today':
                            filterParam = 'Today';
                            break;

                        case 'week':
                            filterParam = 'Last 7 Days';
                            break;

                        case 'month':
                            filterParam = 'Last 30 Days';
                            break;

                        case 'year':
                            filterParam = 'Last Year';
                            break;

                        case 'custom':
                            filterParam = 'custom';
                            startDate = document.getElementById('start-date').value;
                            endDate = document.getElementById('end-date').value;
                            break;

                        default:
                           
                            filterParam = 'All';
                            break;
                    }

                    window.location.href = `/admin/generate-pdf?date=${encodeURIComponent(filterParam)}&startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;
                });

                document.getElementById('export-excel').addEventListener('click', function () {
                    switch (currentFilter.preset) {
                        case 'today':
                            filterParam = 'Today';
                            break;

                        case 'week':
                            filterParam = 'Last 7 Days';
                            break;

                        case 'month':
                            filterParam = 'Last 30 Days';
                            break;

                        case 'year':
                            filterParam = 'Last Year';
                            break;

                        case 'custom':
                            filterParam = 'custom';
                            startDate = document.getElementById('start-date').value;
                            endDate = document.getElementById('end-date').value;
                            break;

                        default:

                            filterParam = 'All';
                            break;
                    }


                    window.location.href = `/admin/salesReportExcel?date=${encodeURIComponent(filterParam)}&startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;
                });

                // Initialize
                setDatesFromPreset('today');
                updateActiveFilters();

                async function pagination(action) {

                    const prevBtn = document.getElementById('prevBtn')
                    const nextBtn = document.getElementById('nextBtn')
                    let currentPage = parseInt(document.getElementById('currentPage').textContent)

                    currentPage = action === 'next' ? currentPage + 1 : currentPage - 1
                    if (currentPage < 1) currentPage = 1

                    switch (currentFilter.preset) {
                        case 'today':
                            filterParam = 'Today'
                            break;
                        case 'week':
                            filterParam = 'Last 7 Days'
                            break;
                        case 'month':
                            filterParam = 'Last 30 Days';
                            break;
                        case 'year':
                            filterParam = 'Last Year';
                            break;
                        case 'custom':
                            filterParam = 'custom';
                            startDate = document.getElementById('start-date').value;
                            endDate = document.getElementById('end-date').value;
                            break;
                        default:
                            filterParam = 'All Time';
                            startDate = null;
                            endDate = null;
                            break;
                    }

                   
                    const response = await fetch(`/admin/salesReport?page=${encodeURIComponent(currentPage)}&date=${encodeURIComponent(filterParam)}&startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`, {
                        headers: { 'Accept': 'application/json' }
                    })

                    const data = await response.json()
                    const orders = data.orders

                    document.getElementById('currentPage').textContent = data.currentPage


                    const tbody = document.getElementById('sales-table-body')
                    tbody.innerHTML = ''

                    let tableNumber = (currentPage-1)*5
                 
                    
                    tableNumber+=1
                   
             orders.forEach(order => {
    let totalRefund = 0;

    if (order.orderedItems && order.orderedItems.length > 0) {
        order.orderedItems.forEach(item => {
            totalRefund += item.reFund || 0;
        });
    }

    const tr = document.createElement('tr');
    tr.innerHTML = `
        <td>${tableNumber++}</td>
        <td>${new Date(order.createdOn).toLocaleDateString('en-IN', {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
        })}</td>
        <td>${order.userId?.username || '-'}</td>
        <td>${order.finalAmount}</td>
        <td><span class="discount-badge">${order.discount || 0}</span></td>
        <td>
            ${
                order.couponApplied?.applied
                    ? `<span class="coupon-badge">${order.couponApplied.code}</span>`
                    : `<span class="coupon-badge-notused">None</span>`
            }
        </td>
        <td class="status ${order.status.toLowerCase()}">${order.status}</td>
        <td>
            <a href="/admin/orderDetails?orderId=${order.orderId}" class="btn btn-sm view-btn">
                <i class="bi bi-eye me-1"></i> View
            </a>
        </td>
    `;

    tbody.appendChild(tr);
});


                    renderPagination(data.currentPage, data.totalPage)

                }

                function renderPagination(currentPage, totalPage) {
                    const paginationContainer = document.querySelector('.pagination')

                    paginationContainer.innerHTML = ''


                    if (currentPage > 1) {
                        const prevBtn = document.createElement('button');
                        prevBtn.className = 'page-btn prev';
                        prevBtn.innerHTML = '&laquo;';
                        prevBtn.onclick = () => pagination('previous');
                        paginationContainer.appendChild(prevBtn);
                    }


                    const currentBtn = document.createElement('button');
                    currentBtn.id = 'currentPage';
                    currentBtn.className = 'page-btn active';
                    currentBtn.textContent = currentPage;
                    paginationContainer.appendChild(currentBtn);

                    if (currentPage < totalPage) {
                        const nextBtn = document.createElement('button');
                        nextBtn.className = 'page-btn next';
                        nextBtn.innerHTML = '&raquo;';
                        nextBtn.onclick = () => pagination('next');
                        paginationContainer.appendChild(nextBtn);
                    }
                }

            </script>
</body>

</html>