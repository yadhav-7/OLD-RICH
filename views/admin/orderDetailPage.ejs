<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - Admin Panel</title>
    <link rel="icon" href="/adminTitleIcon/Gemini_Generated_Image_19c76t19c76t19c7.png" type="image/png">
 <link rel="stylesheet" href="/admin/orderDetailPage.css">
   
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <%- include('../../views/partials/admin/adminHeaders', {title: 'adminHeader-page' }) %>
        <%- include('../../views/partials/admin/adminSidebar', {title: 'adminSidebar-page' }) %>
</head>

<body>
    <div class="main-container">
        <div class="container">
            <div class="header">
                <h1>Order Details</h1>
            </div>

            <div class="section">
                <h2 class="section-title">Order Information</h2>
                <div class="info-grid">
                    <div class="info-label">Order ID:</div>
                    <div class="info-value">
                        <%= order.orderId %>
                    </div>
                    <div class="info-label">Order Date:</div>
                    <div class="info-value">
                        <%= new Date(order.createdOn).toLocaleDateString() %>
                    </div>
                    <div class="info-label">Total Amount:</div>
                    <div class="info-value">₹<%= order.finalAmount %>
                    </div>
                    <div class="info-label">Status:</div>
                    <div class="info-value">
                        <% if(order.status==='returnRequested' ){ %>
                            <span class="status-badge status-return">Return Requested</span>
                            <% } else if(order.status==='Completed' ){ %>
                                <span class="status-badge status-completed">Completed</span>
                                <% } else if(order.status==='Cancelled' ){ %>
                                    <span class="status-badge status-cancelled">Cancelled</span>
                                    <% } else { %>
                                        <span class="status-badge status-clarify">
                                            <%= order.status %>
                                        </span>
                                        <% } %>
                    </div>
                    <div class="info-label">Payment Method:</div>
                    <div class="info-value">
                        <%= order.paymentMethod %>
                    </div>
                </div>
            </div>

            <% if ((order.status==='returned' || order.status==='returnRequested') && order.returnReason) { %>
                <div class="return-notification">
                    <p>
                        <strong>Return Requested</strong> for Order: <%= order.productName %>
                            <% if(order.size){ %> (Size: <%= order.size %>) <% } %>
                    </p>
                    <div class="return-actions">
                        <% if(order.status==='returnRequested'){ %>
                            <button class="btn btn-approve"
                            onclick="handleReturnAction('<%= null %>', '<%= order.orderId %>', 'returned')">
                            Accept
                        </button>
                        <button class="btn btn-reject"
                            onclick="handleReturnAction('<%= null %>', '<%= order.orderId %>', 'reutrnRejected')">
                            Reject
                        </button>
                       <% }else if(order.status==='returned' ){ %>
                        <span class="returned-seal">✔ Returned</span>
                      <% }else if(order.status==='returnRejected' ){ %>
                        <span class="rejected-seal">✖ Rejected</span>
                     <% } %>
                    </div>

                    <p>
                        Reason: <%= order.returnReason || 'No reason given' %>
                    </p>

                </div>
                <% }else{ %>

                    <% order.orderedItems?.forEach((element)=> { %>
                        <% if (element.status==='returnRequested' && element.returnReason) { %>
                            <div class="return-notification">
                                <p>
                                    <strong>Return Requested</strong> for item:
                                    <%= element.product.productName %>
                                        <% if (element.size) { %>
                                            (Size: <%= element.size %>)
                                                <% } %>
                                                    <br>
                                                    Reason: <%= element.returnReason || 'No reason given' %>
                                </p>

                                <div>
                                    <img src="<%= element.product.productImage[0] %>" alt="Product Image"
                                        style="width: 100px;">
                                </div>
                                <div class="return-actions">
                                    <button class="btn btn-approve"
                                        onclick="handleReturnAction( '<%= element._id %>','<%= order.orderId %>', 'returned')">
                                        Accept
                                    </button>
                                    <button class="btn btn-reject"
                                        onclick="handleReturnAction( '<%= element._id %>','<%= order.orderId %>', 'returnRejected')">
                                        Reject
                                    </button>
                                </div>


                            </div>
                            <% }else if(element.status==='returned'||element.status==='reutrnRejected'){%>
                                <div class="return-notification">
    <p>
        <strong>Return Requested</strong> for item: 
        <%= element.product.productName %> 
        <% if (element.size) { %> 
            (Size: <%= element.size %>) 
        <% } %>
        <br>
        Reason: <%= element.returnReason || 'No reason given' %>
    </p>

    <div>
        <img src="<%= element.product.productImage[0] %>" alt="Product Image" style="width: 100px;">
    </div>

    <div class="return-actions">
        <% if (element.status === 'returnRequested') { %>
            <!-- Show Accept / Reject buttons only if currently requested -->
            <button class="btn btn-approve"
                onclick="handleReturnAction('<%= element._id %>', '<%= order.orderId %>', 'returned')">
                Accept
            </button>
            <button class="btn btn-reject"
                onclick="handleReturnAction('<%= element._id %>', '<%= order.orderId %>', 'returnRejected')">
                Reject
            </button>
        <% } else if (element.status === 'returned') { %>
            <!-- Show Returned seal -->
            <span class="returned-seal">✔ Returned</span>
        <% } else if (element.status === 'reutrnRejected') { %>
            <!-- Show Rejected seal -->
            <span class="rejected-seal">✖ Rejected</span>
        <% } %>
    </div>
</div>

                            <% } %>
                                <% }); %>


                                    <% } %>

                                        <div class="section">
                                            <h2 class="section-title">Shipping Address</h2>
                                            <div class="info-grid">
                                                <div class="info-label">Name:</div>
                                                <div class="info-value">
                                                    <%= order?.address?.name %>
                                                </div>
                                                <div class="info-label">Address:</div>
                                                <div class="info-value">
                                                    <%= order?.address?.street %><br>
                                                        <%= order?.address?.city %>, <%= order?.address?.state %><br>
                                                                <%= order?.address?.country %> - <%=
                                                                        order?.address?.pincode %>
                                                </div>
                                                <div class="info-label">Phone:</div>
                                                <div class="info-value">
                                                    <%= order?.address?.phone %>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="section">
                                            <h2 class="section-title">Order Items</h2>
                                            <table class="items-table">
                                                <thead>
                                                    <tr>
                                                        <th>Product</th>
                                                        <th>Size</th>
                                                        <th>Quantity</th>
                                                        <th>Status</th>
                                                        <th>Price</th>
                                                        <th>Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% order?.orderedItems?.forEach(element=> { %>
                                                        <tr>
                                                            <td>
                                                                <%= element.productName %>
                                                            </td>
                                                            <td>
                                                                <%= element.size %>
                                                            </td>
                                                            <td>
                                                                <%= element.quantity %>
                                                            </td>
                                                            <td>
                                                                <% if(element.status==='returnRequested' ){ %>
                                                                    <span class="status-badge status-return">Return
                                                                        Requested</span>
                                                                    <% } else if(element.status==='Completed' ){ %>
                                                                        <span
                                                                            class="status-badge status-completed">Completed</span>
                                                                        <% } else if(element.status==='Cancelled' ){ %>
                                                                            <span
                                                                                class="status-badge status-cancelled">Cancelled</span>
                                                                            <% } else { %>
                                                                                <span
                                                                                    class="status-badge status-clarify">
                                                                                    <%= element.status %>
                                                                                </span>
                                                                                <% } %>
                                                            </td>
                                                            <td>₹<%= element.price %>
                                                            </td>
                                                            <td>₹<%= (element.price * element.quantity).toFixed(2) %>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
        </div>
    </div>
    <script>

        // Example handler for Accept/Reject (replace with your AJAX logic)
        async function handleReturnAction(itemId, orderId, newStatus) {
            try {
                const response = await fetch('/admin/handleReturnReq?_method=PATCH', {
                    method: 'post',
                    headers: {
                        'Content-type': 'application/json'
                    },
                    body: JSON.stringify({
                        itemId,
                        orderId,
                        newStatus
                    })
                })

                const data = await response.json()
                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: data.message || 'Order status updated successfully.',
                        timer: 1800,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed!',
                        text: data.message || 'Failed to update order status.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'Something went wrong. Please try again.',
                    timer: 2000,
                    showConfirmButton: false
                });
            }
        }
    </script>
</body>

</html>