<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Management</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/admin/customers.css">
    <link rel="icon" href="/adminTitleIcon/Gemini_Generated_Image_19c76t19c76t19c7.png" type="image/png">

</head>

<body>
    <%- include('../../views/partials/admin/adminHeaders', {title: 'adminHeader-page' }) %>
        <%- include('../../views/partials/admin/adminSidebar', {title: 'adminSidebar-page' }) %>

            <div class="main-content">
                <h1 class="page-title">Customer Management</h1>

                <div class="search-container">
                    <div class="search-wrapper">
                        <input type="text" id="search-input" class="form-control" placeholder="Search customers...">
                        <button id="clear-button" aria-label="Clear search">×</button>
                    </div>
                </div>

                <div class="table-container">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone No</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="user-table">
                                <% for(let i=0 ; i<data.length ; i ++){ %>
                                    <tr>
                                        <td>
                                            <%= data[i].username %>
                                        </td>
                                        <td>
                                            <%= data[i].email %>
                                        </td>
                                        <td>
                                            <%= data[i].phone %>
                                        </td>
                                        <td>
                                            <% if (data[i].isBlock) { %>
                                                <button class="unblock-btn" id="btn-<%= data[i]._id %>"
                                                    onclick="unblockPermission('<%= data[i]._id %>', '<%= data[i].username %>')">
                                                    Unblock
                                                </button>
                                                <% } else { %>
                                                    <button class="block-btn" id="btn-<%= data[i]._id %>"
                                                        onclick="blockPermission('<%= data[i]._id %>', '<%= data[i].username %>')">
                                                        Block
                                                    </button>
                                                    <% } %>
                                        </td>
                                    </tr>
                                    <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Card View for mobile screens -->
                <div class="card-container" id="card-container">
                    <% for(let i=0 ; i<data.length ; i ++){ %>
                        <div class="customer-card">
                            <div class="customer-info">
                                <strong>Name:</strong>
                                <%= data[i].username %>
                            </div>
                            <div class="customer-info">
                                <strong>Email:</strong>
                                <%= data[i].email %>
                            </div>
                            <div class="customer-info">
                                <strong>Phone:</strong>
                                <%= data[i].phone %>
                            </div>
                            <div class="customer-info">
                                <strong>Action:</strong>
                                <% if (data[i].isBlock) { %>
                                    <button class="unblock-btn" id="card-btn-<%= data[i]._id %>"
                                        onclick="unblockPermission('<%= data[i]._id %>', '<%= data[i].username %>')">
                                        Unblock
                                    </button>
                                    <% } else { %>
                                        <button class="block-btn" id="card-btn-<%= data[i]._id %>"
                                            onclick="blockPermission('<%= data[i]._id %>', '<%= data[i].username %>')">
                                            Block
                                        </button>
                                        <% } %>
                            </div>
                        </div>
                        <% } %>
                </div>

                <div class="pagination-container">
                    <nav>
                        <ul class="pagination" id="pagination">
                            <% if(currentPage> 1) { %>
                                <li class="page-item">
                                    <a class="page-link" href="/admin/users?page=<%= currentPage-1 %>"
                                        aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                <% } %>

                                    <li class="page-item active">
                                        <a class="page-link" href="#">
                                            <%= currentPage %>
                                        </a>
                                    </li>

                                    <% if(currentPage < totalPages) { %>
                                        <li class="page-item">
                                            <a class="page-link" href="/admin/users?page=<%= currentPage+1 %>"
                                                aria-label="Next">
                                                <span aria-hidden="true">&raquo;</span>
                                            </a>
                                        </li>
                                        <% } %>
                        </ul>
                    </nav>
                </div>
            </div>

            <!-- Bootstrap JS Bundle with Popper -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <!-- SweetAlert2 -->
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

            <script>
                function toggleSidebar() {
                    document.body.classList.toggle('collapsed');
                }
            </script>
            <script src="/js/admin/customers.js"></script>
</body>

</html>