<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="icon" href="/adminTitleIcon/Gemini_Generated_Image_19c76t19c76t19c7.png" type="image/png">

    <link rel="stylesheet" href="/admin/adminDashboard.css">
</head>

<body>
    <%- include('../../views/partials/admin/adminHeaders', {title: 'adminHeader-page' }) %>
        <%- include('../../views/partials/admin/adminSidebar', {title: 'adminSidebar-page' }) %>

            <!-- Dashboard Content -->
            <div class="dashboard-container container-fluid px-0">
                <!-- Main Content -->
                <div class="main-content">

                    <!-- Filter Section -->
                    <div class="text-center my-4">
                        <h5 class="mb-3 fw-bold">Filter Reports</h5>

                        <!-- Filter Buttons -->
                        <div id="filterButtons" class="btn-group mb-3 flex-wrap justify-content-center" role="group">
                            <button type="button" class="btn btn-outline-yellow" data-filter="daily">Daily</button>
                            <button type="button" class="btn btn-outline-yellow" data-filter="weekly">Weekly</button>
                            <button type="button" class="btn btn-outline-yellow" data-filter="monthly">Monthly</button>
                            <button type="button" class="btn btn-outline-yellow" data-filter="yearly">Yearly</button>
                            <button type="button" class="btn btn-outline-yellow" data-filter="custom">Custom</button>
                        </div>

                        <!-- Custom Date Inputs -->
                        <div id="customDateInputs" class="custom-inputs mt-3" style="display: none;">
                            <div class="row g-2 justify-content-center">
                                <div class="col-12 col-md-auto">
                                    <input type="date" id="startDate" class="form-control">
                                </div>
                                <div class="col-12 col-md-auto d-flex align-items-center justify-content-center">
                                    <span>to</span>
                                </div>
                                <div class="col-12 col-md-auto">
                                    <input type="date" id="endDate" class="form-control">
                                </div>
                                <div class="col-12 col-md-auto">
                                    <button id="applyCustomFilter" class="btn btn-yellow w-100 w-md-auto">Apply</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Section -->
                    <div class="additional-charts">
                        <!-- Top Products Full Width -->
                        <div class="row g-4 mb-4">
                            <div class="col-12">
                                <div class="report">
                                    <div class="report-header mb-3">
                                        <h2 class="h5 m-0">Top Selling Products</h2>
                                    </div>
                                    <div class="chart-container">
                                        <% if (topProducts && topProducts.length> 0) { %>
                                            <canvas id="productsChart"></canvas>
                                            <% } else { %>
                                                <div class="d-flex justify-content-center align-items-center h-100">
                                                    <p class="text-muted">No Data Available</p>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    <!-- Category & Brands Charts Row -->
                    <div class="row g-4 mt-2">
                        <!-- Top Categories -->
                        <div class="col-12 col-xl-6">
                            <div class="report">
                                <div class="report-header mb-3">
                                    <h2 class="h5 m-0">Sales by Category</h2>
                                </div>
                                <div class="chart-container">
                                    <% if (topCategory && topCategory.length > 0) { %>
                                        <canvas id="categoriesChart"></canvas>
                                    <% } else { %>
                                        <div class="d-flex justify-content-center align-items-center h-100">
                                            <p class="text-muted">No Category Data Available</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Top Brands -->
                        <div class="col-12 col-xl-6">
                            <div class="report">
                                <div class="report-header mb-3">
                                    <h2 class="h5 m-0">Top Selling Brands</h2>
                                </div>
                                <div class="chart-container">
                                    <% if (topBrands && topBrands.length > 0) { %>
                                        <canvas id="brandsChart"></canvas>
                                    <% } else { %>
                                        <div class="d-flex justify-content-center align-items-center h-100">
                                            <p class="text-muted">No Brand Data Available</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/admin/dashboard.js"></script>
            <script>
                window.DASHBOARD_DATA = {
                    topProducts: <%- JSON.stringify(topProducts || []) %>,
                    topCategory: <%- JSON.stringify(topCategory || []) %>,
                    topBrands: <%- JSON.stringify(topBrands || []) %>
                };
            </script>
</body>

</html>