<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | Old Money Clothes</title>
  <link rel="icon" href="/adminTitleIcon/Gemini_Generated_Image_19c76t19c76t19c7.png" type="image/png">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

  <link rel="stylesheet" href="/admin/login.css">
</head>

<body>
  <div class="login-container">
    <div class="login-header">
      <div class="brand-logo">OR</div>
      <h2>Admin Login</h2>
      <p>Access the Old Money Clothes Admin Portal</p>
    </div>

    <% if (typeof message !=='undefined' && message) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <% } %>

        <form id="loginForm" action="/admin/login" method="POST" novalidate>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" placeholder="Enter email" name="email"
              aria-describedby="emailError emailHelp" required>
            <div id="emailError" class="error-message"></div>
            <div id="emailHelp" class="form-text">Enter your admin email address</div>
          </div>

          <div class="mb-3 password-container">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" placeholder="Enter password" name="password"
              aria-describedby="passwordError passwordHelp" required minlength="8">
            <button type="button" class="password-toggle" id="togglePassword">
              <i class="bi bi-eye-slash"></i>
            </button>
            <div id="passwordError" class="error-message"></div>
            <div id="passwordHelp" class="form-text">Minimum 8 characters</div>
          </div>

          <button type="submit" class="btn btn-custom mt-3" id="submitButton">
            <span id="buttonText">Login</span>
            <span id="buttonSpinner" class="spinner-border spinner-border-sm d-none" role="status"
              aria-hidden="true"></span>
          </button>

          <div class="admin-login-info">
            <strong>Welcome to the Old Money Clothes Admin Portal</strong> – Manage products, orders, and users with
            ease and security.
          </div>
        </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <script src="/js/admin/admin-login.js"></script>
</body>

</html>